# Solana RPC (devnet by default)
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_CLUSTER=devnet

# PUSD mint address. On devnet, run `pnpm setup-devnet` to mint a mock PUSD
# and paste the address here. On mainnet, replace with the official PUSD mint.
NEXT_PUBLIC_PUSD_MINT=
NEXT_PUBLIC_PUSD_DECIMALS=6

# Optional: app base URL used to build claim links
NEXT_PUBLIC_APP_URL=http://localhost:3000
